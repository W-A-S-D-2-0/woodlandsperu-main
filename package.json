{
  "name": "woodland-peru",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:landing": "tsc -b && vite build --config vite.landing.config.ts",
    "build:panel": "tsc -b && vite build --config vite.panel.config.ts",
    "preview": "npm run build && vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && vite build && vite build --config vite.landing.config.ts && vite build --config vite.panel.config.ts",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "deploy:api": "wrangler deploy --config wrangler.api.jsonc",
    "demo": "node scripts/demo/grabar-demo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.13.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
